# ---------------- برنامه ----------------
APP_NAME="جواب"
APP_DEBUG=false
# یک رشته‌ی تصادفی طولانی (برای هش IP و ...)
APP_KEY=change-this-to-a-long-random-string
APP_TIMEZONE=Asia/Tehran
# اگر پشت Cloudflare یا پراکسی هستید true کنید
TRUST_PROXY=false

# ---------------- دیتابیس MySQL ----------------
# اگر دیتابیس وجود نداشته باشد (و کاربر اجازه داشته باشد) خودکار ساخته می‌شود
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=javab
DB_USERNAME=root
DB_PASSWORD=

# ---------------- هوش مصنوعی ----------------
# سرویس پیش‌فرض: Agnes AI (سازگار با OpenAI). کلید را از داشبورد platform.agnes-ai.com بسازید.
AI_URL=https://apihub.agnes-ai.com/v1/chat/completions
AI_MODEL=agnes-2.5-flash
# کلید API (به‌صورت Authorization: Bearer ارسال می‌شود)
AI_API_KEY=
# اگر true باشد و کلید خالی باشد، درخواستی به AI ارسال نمی‌شود (برای سرویس‌های بدون کلید false کنید)
AI_REQUIRE_KEY=true
# افزودن /no_think به انتهای پیام (فقط برای مدل‌های Qwen3 که حالت تفکر دارند)
AI_NO_THINK=false
AI_TIMEOUT=60
AI_TEMPERATURE=0.0
AI_TOP_P=0.9
AI_MAX_TOKENS=1200
# تعداد تلاش دوباره در خطای موقت
AI_RETRIES=1
# سقف توکن خروجی برای «تحلیل دانشنامه‌ها» (هر بسته‌ی تحلیل)
AI_ANALYSIS_MAX_TOKENS=3000

# ---------------- ریت لیمیت مدل هوش مصنوعی ----------------
# حداکثر درخواست به مدل در دقیقه / روز (کل سیستم)
AI_RATE_PER_MINUTE=20
AI_RATE_PER_DAY=2000
# حداکثر درخواست هم‌زمان به مدل
AI_MAX_CONCURRENT=3
# اگر مدل خطای 429 داد و Retry-After نفرستاد، چند ثانیه صبر شود
AI_COOLDOWN_SECONDS=30

# ---------------- ریت لیمیت کاربران (بر اساس IP) ----------------
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_HOUR=60

# ---------------- دانشنامه و دقت پاسخ ----------------
# پاسخ فقط وقتی ارسال می‌شود که درصد اطمینان حداقل این مقدار باشد
MIN_CONFIDENCE=80
# شباهت سوال با یک سوال دانشنامه از این بیشتر باشد → پاسخ مستقیم بدون AI (۰ تا ۱)
KB_DIRECT_MATCH=0.92
# حداقل شباهت برای فرستادن به AI (فقط وقتی دانشنامه بزرگ است)
KB_MIN_RELEVANCE=0.12
# اگر تعداد موارد دانشنامه کمتر از این باشد، همه‌ی آن به AI فرستاده می‌شود
KB_SEND_ALL_BELOW=30
# تعداد نزدیک‌ترین موارد که برای AI فرستاده می‌شود
KB_TOP_K=12
KB_SCAN_LIMIT=20000
# چند پیام قبلی گفتگو برای فهم سوال‌های ادامه‌دار
CHAT_HISTORY_MESSAGES=4
# مدت نگهداری کش پاسخ‌ها (ثانیه)
ANSWER_CACHE_TTL=86400
NO_ANSWER_MESSAGE="متأسفم، برای این سوال پاسخ دقیقی در دانشنامه پیدا نکردم. سوال شما ثبت شد تا پاسخ آن اضافه شود."
